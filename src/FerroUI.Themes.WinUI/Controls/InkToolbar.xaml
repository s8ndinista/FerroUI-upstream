<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="InkToolbarCommonButtonStyle" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="{StaticResource InkToolbarButtonWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource InkToolbarButtonHeight}" />
    <Setter Property="MaxWidth" Value="{StaticResource InkToolbarButtonWidth}" />
    <Setter Property="MaxHeight" Value="{StaticResource InkToolbarButtonHeight}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="{DynamicResource InkToolbarButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource InkToolbarButtonBorderThemeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="2" CornerRadius="{DynamicResource ControlCornerRadius}"
                BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}">
          <Border BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                  BorderBrush="{DynamicResource SystemControlFocusVisualSecondaryBrush}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonForegroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonBorderBrushPointerOver}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonForegroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonBorderBrushPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonBackgroundDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonForegroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonBorderBrushDisabled}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonSelectedBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonSelectedForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonSelectedBorderBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonSelectedBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonSelectedForegroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonSelectedBorderBrushPointerOver}" />
    </Style>
    <Style Selector="^:checked:pressed">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonSelectedBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonSelectedForegroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonSelectedBorderBrushPressed}" />
    </Style>
    <Style Selector="^:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource InkToolbarButtonSelectedBackgroundDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarButtonSelectedForegroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarButtonSelectedBorderBrushDisabled}" />
    </Style>
    <Style Selector="^ /template/ Path#ExtensionGlyph">
      <Setter Property="Data" Value="{StaticResource InkToolbarArrowDown}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ Path#ExtensionGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:flyout-top /template/ Path#ExtensionGlyph">
      <Setter Property="Data" Value="{StaticResource InkToolbarArrowUp}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="^:flyout-bottom /template/ Path#ExtensionGlyph">
      <Setter Property="Data" Value="{StaticResource InkToolbarArrowDown}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="5" />
    </Style>
    <Style Selector="^:flyout-left /template/ Path#ExtensionGlyph">
      <Setter Property="Data" Value="{StaticResource InkToolbarArrowLeft}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="^:flyout-right /template/ Path#ExtensionGlyph">
      <Setter Property="Data" Value="{StaticResource InkToolbarArrowRight}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="8" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbarToolButton}" TargetType="InkToolbarToolButton" BasedOn="{StaticResource InkToolbarCommonButtonStyle}">
    <Setter Property="Template">
      <ControlTemplate TargetType="InkToolbarToolButton">
        <Border x:Name="RootElement" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <Path x:Name="ExtensionGlyph" Stretch="Uniform"
                  Fill="{DynamicResource InkToolbarAccentColorForegroundThemeBrush}"
                  IsVisible="{TemplateBinding IsExtensionGlyphShown}" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
