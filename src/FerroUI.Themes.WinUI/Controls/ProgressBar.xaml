<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/ProgressBar/ProgressBar.xaml (the implicit style; the resources of
    controls/dev/ProgressBar/ProgressBar_themeresources.xaml are
    Resources/ProgressBar_themeresources.xaml)
    controls/dev/CommonStyles/Deprecated_themeresources.xaml (DefaultProgressBarStyle, a keyed
    style without setters, which WinUI applies over the default style)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - The implicit style of the source is the keyed theme DefaultProgressBarStyle, which the
    default theme of ProgressBar is based on: an application that sets the empty keyed style of
    WinUI gets the default style, as with this theme.
  - Template parts: DeterminateProgressBarIndicator is FerroUI's PART_Indicator, which must be a
    Border; the rectangles of the source (ProgressBarTrack and the indicators) are borders, their
    RadiusX/RadiusY (the corner radius of the control through TopLeft/BottomRight converters,
    ProgressBarTrackCornerRadius for the track) are corner radii. The control sets the width of
    PART_Indicator from the value as WinUI's control does; the indeterminate indicators take
    their widths from TemplateSettings (ContainerWidth, Container2Width), which WinUI's control
    sets in code.
  - The inner Border with Clip="{Binding TemplateSettings.ClipRect}" (the area inside the
    padding) clips to its bounds (ClipToBounds), the same area.
  - CommonStates: Determinate is the base. Indeterminate shows the indeterminate indicators and
    hides the track (its setters) and runs the storyboard of the source as keyframe animations
    of the translation of each indicator (2 s, forever, spline 0.4,0,0.6,1, the key times of the
    source) in the nested style of :indeterminate; PART_Indicator is hidden, which WinUI does by
    setting its width to 0 in code. FerroUI's ProgressBar has no ShowError and no ShowPaused:
    Error, Paused, UpdatingError, IndeterminateError and IndeterminatePaused have no
    counterpart. Updating and the visual transitions (RepositionThemeAnimation of the indicator
    when the value changes, FadeInThemeAnimation when an indeterminate bar becomes determinate,
    the colour animations from Error and Paused) are not ported.
  - FerroUI's ProgressBar has an Orientation, WinUI's has none: the vertical bar is the
    horizontal one turned, with the track and the indicators along the height, PART_Indicator at
    the bottom, and the minimum width of ProgressBarMinHeight.
  - FerroUI's ShowProgressText has no counterpart in WinUI: the text (ProgressTextFormat with the
    value, the percentage, the minimum and the maximum) is shown after the bar, under a vertical
    bar, in TextFillColorPrimaryBrush.
  - ProgressBarTrack binds its Width to the Width of the control; the port lets it stretch, which
    is the same width inside the bar. IsTabStop is kept.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:FerroUI.Controls.Converters"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <StackPanel Spacing="20" Width="200">
          <ProgressBar Value="0" />
          <ProgressBar Value="40" />
          <ProgressBar Value="100" />
          <ProgressBar IsIndeterminate="True" />
          <ProgressBar ShowProgressText="True" Value="40" />
        </StackPanel>
        <ProgressBar Orientation="Vertical" Value="40" Height="200" />
        <ProgressBar Orientation="Vertical" IsIndeterminate="True" Height="200" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- The text of ShowProgressText (FerroUI): ProgressTextFormat with its arguments. -->
  <converters:StringFormatConverter x:Key="ProgressBarTextFormatConverter" />

  <ControlTheme x:Key="DefaultProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource ProgressBarForeground}" />
    <Setter Property="Background" Value="{DynamicResource ProgressBarBackground}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ProgressBarBorderThemeThickness}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ProgressBarBorderBrush}" />
    <Setter Property="MinHeight" Value="{StaticResource ProgressBarMinHeight}" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{StaticResource ProgressBarCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="LayoutRoot" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <Border x:Name="ProgressBarRoot"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="ProgressBarClip" ClipToBounds="True">
              <Grid x:Name="ProgressBarGrid">
                <Border x:Name="ProgressBarTrack"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource ProgressBarTrackCornerRadius}" />
                <Border x:Name="PART_Indicator"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                <Border x:Name="IndeterminateProgressBarIndicator"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
                <Border x:Name="IndeterminateProgressBarIndicator2"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0" />
              </Grid>
            </Border>
          </Border>
          <LayoutTransformControl x:Name="ProgressTextRoot"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding ShowProgressText}">
            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ProgressBarTextFormatConverter}">
                  <TemplateBinding Property="ProgressTextFormat" />
                  <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                  <TemplateBinding Property="Percentage" />
                  <TemplateBinding Property="Minimum" />
                  <TemplateBinding Property="Maximum" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </LayoutTransformControl>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- The horizontal bar of the source: Grid Height="{TemplateBinding MinHeight}", the track
         ProgressBarTrackHeight high and centred, the indicators from the left. -->
    <Style Selector="^:horizontal">
      <Style Selector="^ /template/ Grid#ProgressBarGrid">
        <Setter Property="Height" Value="{TemplateBinding MinHeight}" />
      </Style>
      <Style Selector="^ /template/ Border#ProgressBarTrack">
        <Setter Property="Height" Value="{StaticResource ProgressBarTrackHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
      </Style>
    </Style>

    <!-- The vertical bar (FerroUI): the horizontal one turned. -->
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="{StaticResource ProgressBarMinHeight}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Style Selector="^ /template/ Grid#ProgressBarGrid">
        <Setter Property="Width" Value="{TemplateBinding MinWidth}" />
      </Style>
      <Style Selector="^ /template/ Border#ProgressBarTrack">
        <Setter Property="Width" Value="{StaticResource ProgressBarTrackHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="VerticalAlignment" Value="Bottom" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2Width}" />
      </Style>
      <Style Selector="^ /template/ LayoutTransformControl#ProgressTextRoot">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
    </Style>

    <!-- Indeterminate -->
    <Style Selector="^:indeterminate">
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Border#ProgressBarTrack">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Indicator">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </Style>
    <!-- The storyboard of Indeterminate (RepeatBehavior="Forever"): the translation of
         IndeterminateProgressBarIndicator from ContainerAnimationStartPosition to
         ContainerAnimationEndPosition in 1.5 s, held to 2 s, and of
         IndeterminateProgressBarIndicator2 held at Container2AnimationStartPosition to 0.75 s,
         then to Container2AnimationEndPosition at 2 s. -->
    <Style Selector="^:horizontal:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.5">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:2">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:horizontal:indeterminate /template/ Border#IndeterminateProgressBarIndicator2">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:0.75">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.5">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:vertical:indeterminate /template/ Border#IndeterminateProgressBarIndicator2">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeyTime="0:0:0.75">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationStartPosition}" />
          </KeyFrame>
          <KeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2">
            <Setter Property="TranslateTransform.Y" Value="{Binding $parent[ProgressBar].TemplateSettings.Container2AnimationEndPosition}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}" />
</ResourceDictionary>
