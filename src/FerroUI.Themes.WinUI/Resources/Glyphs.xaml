<!--
  Not ported from a document: the outlines the port draws where the templates of microsoft-ui-xaml
  (https://github.com/microsoft/microsoft-ui-xaml, commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0)
  show a glyph of the symbol font (FontIcon, FontIconSource or a TextBlock in
  SymbolThemeFontFamily, "Segoe Fluent Icons,Segoe MDL2 Assets"). The font is part of Windows,
  is not redistributable and does not exist on the other platforms, so a template of the port
  draws the glyph as a path of the geometry GlyphGeometry<code point> (docs/porting/winui-theme.md,
  section 4.7), sized to the ink of the glyph at the font size of the source.

  GlyphGeometryE73E (CheckMark) and GlyphGeometryE894 (Clear) are the outlines of the Fluent theme
  of FerroUI (src/FerroUI.Themes.Fluent/Controls/CheckBox.xaml, TextBox.xaml). The others are drawn
  for the port.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <!-- E73E CheckMark: the check of CheckBox (CheckBoxCheckedGlyph). -->
  <StreamGeometry x:Key="GlyphGeometryE73E">M5.5 10.586 1.707 6.793A1 1 0 0 0 .293 8.207l4.5 4.5a1 1 0 0 0 1.414 0l11-11A1 1 0 0 0 15.793.293L5.5 10.586Z</StreamGeometry>
  <!-- E9AE: the bar of an indeterminate CheckBox (CheckBoxIndeterminateGlyph). -->
  <StreamGeometry x:Key="GlyphGeometryE9AE">M0.75 0h10.5a0.75 0.75 0 0 1 0 1.5H0.75a0.75 0.75 0 0 1 0-1.5Z</StreamGeometry>
  <!-- E894 Clear: the delete button of TextBox. -->
  <StreamGeometry x:Key="GlyphGeometryE894">M 11.416016,10 20,1.4160156 18.583984,0 10,8.5839846 1.4160156,0 0,1.4160156 8.5839844,10 0,18.583985 1.4160156,20 10,11.416015 18.583984,20 20,18.583985 Z</StreamGeometry>
  <!-- EDD9 CaretLeftSolid8, EDDA CaretRightSolid8, EDDB CaretUpSolid8, EDDC CaretDownSolid8: the
       arrows of the line buttons of ScrollBar. -->
  <StreamGeometry x:Key="GlyphGeometryEDD9">M 5,0 L 5,8 L 1,4 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryEDDA">M 0,0 L 4,4 L 0,8 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryEDDB">M 0,5 L 4,1 L 8,5 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryEDDC">M 0,0 L 8,0 L 4,4 Z</StreamGeometry>
  <!-- F136 StatusCircleOuter and F13D StatusCircleErrorX: the error icon of InfoBar
       (InfoBarIconBackgroundGlyph under InfoBarErrorIconGlyph), the icon of the keyed theme
       TooltipDataValidationErrors. F136 is the whole circle of the icon; F13D is the cross inside
       it. -->
  <StreamGeometry x:Key="GlyphGeometryF136">M 8,0 A 8,8 0 1 1 8,16 A 8,8 0 1 1 8,0 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryF13D">M 0,1.41 L 1.41,0 L 5,3.59 L 8.59,0 L 10,1.41 L 6.41,5 L 10,8.59 L 8.59,10 L 5,6.41 L 1.41,10 L 0,8.59 L 3.59,5 Z</StreamGeometry>
  <!-- E711 Cancel: the dismiss button of the date and time picker flyouts (DatePickerFlyoutPresenter,
       TimePickerFlyoutPresenter). -->
  <StreamGeometry x:Key="GlyphGeometryE711">M 0.7,0 6,5.3 11.3,0 12,0.7 6.7,6 12,11.3 11.3,12 6,6.7 0.7,12 0,11.3 5.3,6 0,0.7 Z</StreamGeometry>
  <!-- E787 Calendar: the glyph of CalendarDatePicker. -->
  <StreamGeometry x:Key="GlyphGeometryE787">M 0,0 H 16 V 16 H 0 Z M 1,1 V 3 H 15 V 1 Z M 1,4 V 15 H 15 V 4 Z M 3,6 V 8 H 5 V 6 Z M 7,6 V 8 H 9 V 6 Z M 11,6 V 8 H 13 V 6 Z M 3,10 V 12 H 5 V 10 Z M 7,10 V 12 H 9 V 10 Z M 11,10 V 12 H 13 V 10 Z</StreamGeometry>
  <!-- E8FB Accept: the accept button of the date and time picker flyouts. -->
  <StreamGeometry x:Key="GlyphGeometryE8FB">M 0,7 0.7,6.3 5,10.6 15.3,0.3 16,1 5,12 Z</StreamGeometry>

  <!-- E711 Cancel (InfoBarCloseButtonSymbol, the close button of InfoBar): the outline of E894,
       which the symbol font draws the same. -->
  <StreamGeometry x:Key="GlyphGeometryE711">M 11.416016,10 20,1.4160156 18.583984,0 10,8.5839846 1.4160156,0 0,1.4160156 8.5839844,10 0,18.583985 1.4160156,20 10,11.416015 18.583984,20 20,18.583985 Z</StreamGeometry>
  <!-- F136 StatusCircleOuter and the symbols InfoBar draws over it: F13F StatusCircleInfo, F13D
       StatusCircleErrorX, F13C StatusCircleExclamation, F13E StatusCircleCheckmark
       (InfoBarIconBackgroundGlyph, InfoBarInformationalIconGlyph, InfoBarErrorIconGlyph,
       InfoBarWarningIconGlyph, InfoBarSuccessIconGlyph). The circle is 16 x 16; the symbols are
       drawn at the size of their ink and centred on it. The check mark is the check mark polygon
       of the item chrome of WinUI (CListViewBaseItemChrome::s_checkMarkPoints, 15 x 13). -->
  <StreamGeometry x:Key="GlyphGeometryF136">M8,0 A8,8 0 1 1 8,16 A8,8 0 1 1 8,0 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryF13F">M0.75,0 A0.75,0.75 0 1 1 0.75,1.5 A0.75,0.75 0 1 1 0.75,0 Z M0.75,2.75 A0.625,0.625 0 0 1 1.375,3.375 V7.375 A0.625,0.625 0 0 1 0.125,7.375 V3.375 A0.625,0.625 0 0 1 0.75,2.75 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryF13D">M0.884,0 3,2.116 5.116,0 6,0.884 3.884,3 6,5.116 5.116,6 3,3.884 0.884,6 0,5.116 2.116,3 0,0.884Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryF13C">M0.75,0 A0.625,0.625 0 0 1 1.375,0.625 V4.625 A0.625,0.625 0 0 1 0.125,4.625 V0.625 A0.625,0.625 0 0 1 0.75,0 Z M0.75,6.5 A0.75,0.75 0 1 1 0.75,8 A0.75,0.75 0 1 1 0.75,6.5 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphGeometryF13E">M0,7 L2.2,4.3 L6.1,7.9 L12.4,0 L15,2.4 L6.6,13 Z</StreamGeometry>
</ResourceDictionary>
