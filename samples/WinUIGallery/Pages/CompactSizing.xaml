<!-- Adapted from the pinned CompactSizing page and its two sample pages. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:winui="using:FerroUI.Controls.WinUI" Spacing="20">
  <winui:RadioButtons x:Name="SizingMode" Header="Fluent standard and compact sizing"
                      SelectedIndex="0" MaxColumns="2">
    <RadioButton Content="Standard" />
    <RadioButton Content="Compact" />
  </winui:RadioButtons>
  <winui:Frame x:Name="SizingFrame" HorizontalAlignment="Stretch" />
  <TextBlock x:Name="SizingError" IsVisible="False" TextWrapping="Wrap"
             AutomationProperties.LiveSetting="Polite" />
</StackPanel>
