<!-- The native WinUI 3 counterpart of MenusPage.xaml. Menu is a MenuBar; the content of an open
     menu and of a context menu is a MenuFlyoutPresenter with MenuFlyoutItem, MenuFlyoutSeparator,
     ToggleMenuFlyoutItem and MenuFlyoutSubItem (WinUI shows a context menu as a menu flyout);
     the input gesture is the text of the keyboard accelerator (KeyboardAcceleratorTextOverride).
     The items of each presenter are the items of a MenuFlyout of the resources, given to the
     presenter as its ItemsSource, as MenuFlyout gives its items to the presenter it opens: the
     presenter computes from its ItemsSource whether an item has a toggle, an icon or a keyboard
     accelerator text (MenuFlyoutPresenter::OnItemsSourceChanged), and the items show their check
     and icon placeholders and their accelerator texts only then (with Items, the presenter shows
     neither icons nor accelerator texts). WinUI shows the accelerator texts only where a keyboard
     is present. Every item has the padding of NarrowPadding (MenuFlyoutItemThemePaddingNarrow) as
     a local value: WinUI uses it in a menu opened with the mouse, the pen or the keyboard, which
     the framework's menu items always use, and a presenter outside a menu flyout would have the
     touch padding (DefaultPadding). The pointer-over menu item has
     the brushes of that state as local values, and so has the pointer-over item of the menu bar
     (its template binds the background of its parts to the background of the item; its text
     keeps its colour, as ButtonForegroundPointerOver is MenuBarItemForeground). CommandBar has
     AppBarButton, AppBarSeparator and AppBarToggleButton, with the same path icons and the labels
     at the right (DefaultLabelPosition="Right", shown while the bar is closed). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <StackPanel.Resources>
    <MenuFlyout x:Key="MenuItemsFlyout">
      <MenuFlyoutItem Text="New" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+N">
        <MenuFlyoutItem.Icon>
          <PathIcon Data="M11,5H13V11H19V13H13V19H11V13H5V11H11Z" />
        </MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Open" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+O" />
      <MenuFlyoutItem Text="Pointer over" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}"
                      Background="{ThemeResource MenuFlyoutItemBackgroundPointerOver}"
                      Foreground="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
      <MenuFlyoutSeparator />
      <ToggleMenuFlyoutItem Text="Show hidden files" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" IsChecked="True" />
      <MenuFlyoutSubItem Text="Recent" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}">
        <MenuFlyoutItem Text="Report.docx" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
      </MenuFlyoutSubItem>
      <MenuFlyoutItem Text="Disabled" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" IsEnabled="False" />
    </MenuFlyout>
    <MenuFlyout x:Key="ContextMenuFlyout">
      <MenuFlyoutItem Text="Cut" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+X" />
      <MenuFlyoutItem Text="Copy" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+C" />
      <MenuFlyoutItem Text="Paste" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+V" IsEnabled="False" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem Text="Select all" Padding="{StaticResource MenuFlyoutItemThemePaddingNarrow}" KeyboardAcceleratorTextOverride="Ctrl+A" />
    </MenuFlyout>
  </StackPanel.Resources>
  <TextBlock Text="Menus and command bars" FontSize="28" FontWeight="SemiBold" />

  <TextBlock Text="Menu" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <MenuBar HorizontalAlignment="Left">
    <MenuBarItem Title="File" />
    <MenuBarItem Title="Edit" />
    <MenuBarItem Title="View" Background="{ThemeResource MenuBarItemBackgroundPointerOver}" />
    <MenuBarItem Title="Help" IsEnabled="False" />
  </MenuBar>

  <Grid ColumnSpacing="24" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="12">
      <TextBlock Text="Menu items" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <MenuFlyoutPresenter Width="280" HorizontalAlignment="Left"
                           ItemsSource="{Binding Items, Source={StaticResource MenuItemsFlyout}}" />
    </StackPanel>

    <StackPanel Grid.Column="1" Spacing="12">
      <TextBlock Text="Context menu" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <MenuFlyoutPresenter Width="280" HorizontalAlignment="Left"
                           ItemsSource="{Binding Items, Source={StaticResource ContextMenuFlyout}}" />
    </StackPanel>
  </Grid>

  <TextBlock Text="CommandBar" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <CommandBar DefaultLabelPosition="Right">
    <CommandBar.PrimaryCommands>
      <AppBarButton Label="Add">
        <AppBarButton.Icon>
          <PathIcon Data="M11,5H13V11H19V13H13V19H11V13H5V11H11Z" />
        </AppBarButton.Icon>
      </AppBarButton>
      <AppBarButton Label="Remove">
        <AppBarButton.Icon>
          <PathIcon Data="M5,11H19V13H5Z" />
        </AppBarButton.Icon>
      </AppBarButton>
      <AppBarSeparator />
      <AppBarToggleButton Label="Checked" IsChecked="True">
        <AppBarToggleButton.Icon>
          <PathIcon Data="M4,12.5L5.5,11L9.5,15L18.5,6L20,7.5L9.5,18Z" />
        </AppBarToggleButton.Icon>
      </AppBarToggleButton>
      <AppBarButton Label="Disabled" IsEnabled="False">
        <AppBarButton.Icon>
          <PathIcon Data="M5,5H19V19H5Z M7,7V17H17V7Z" />
        </AppBarButton.Icon>
      </AppBarButton>
    </CommandBar.PrimaryCommands>
    <CommandBar.SecondaryCommands>
      <AppBarButton Label="Settings" />
    </CommandBar.SecondaryCommands>
  </CommandBar>
</StackPanel>
