<!-- The native WinUI 3 counterpart of DialogsPage.xaml. WinUI has no file chooser of its own (an
     application shows the one of the system), so the page is the layout of the managed file
     chooser composed of WinUI controls: an empty list of quick links at the left, a bar with the
     up button, the location and the refresh button, the column headers over an empty list of
     entries, and the file name, the check box of hidden files and the two buttons at the
     bottom. What is compared is the look of those controls in the two themes, not a dialog. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <TextBlock Text="Dialogs" FontSize="28" FontWeight="SemiBold" />

  <TextBlock Text="ManagedFileChooser" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="640" Height="420" HorizontalAlignment="Left"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListView Grid.Column="0" Grid.RowSpan="4" />

    <Grid Grid.Column="1" Grid.Row="0" Margin="12,5,12,5" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0">
        <PathIcon Width="14" Height="14" Data="M11,20V8.8L6.4,13.4L5,12L12,5L19,12L17.6,13.4L13,8.8V20Z" />
      </Button>
      <TextBox Grid.Column="1" />
      <Button Grid.Column="2">
        <PathIcon Width="14" Height="14" Data="M12,4A8,8 0 1,0 20,12H18A6,6 0 1,1 12,6V9L16,5L12,1Z" />
      </Button>
    </Grid>

    <Grid Grid.Column="1" Grid.Row="1" Margin="27,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="Name" />
      <TextBlock Grid.Column="2" Text="Date Modified" />
      <TextBlock Grid.Column="3" Text="Type" />
    </Grid>

    <ListView Grid.Column="1" Grid.Row="2" />

    <Grid Grid.Column="1" Grid.Row="3" Margin="12,0,12,5" RowSpacing="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBox Grid.Row="0" PlaceholderText="File name" />
      <CheckBox Grid.Row="1" Content="Show hidden files" HorizontalAlignment="Left" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
        <Button Content="OK" MinWidth="80" />
        <Button Content="Cancel" MinWidth="80" />
      </StackPanel>
    </Grid>
  </Grid>
</StackPanel>
