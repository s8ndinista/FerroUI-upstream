<!-- The native WinUI 3 counterpart of DialogsPage.xaml. WinUI has no file chooser of its own (an
     application shows the one of the system), so the page is the layout of the managed file
     chooser composed of WinUI controls: an empty list of quick links at the left, a bar with the
     up button (glyph E74A), the location and the refresh button (glyph E72C), the column headers
     with their splitters (the columns of the managed file chooser of the WinUI theme, aligned with
     the padding of a list view item) over an empty list of entries, and the file name, the check
     box of hidden files and the two buttons at the bottom. As the framework's chooser has no view
     model in the gallery, its filter combo box shows (empty) beside the file name and its two
     buttons are disabled (their commands are not bound); the native page shows the same. What is
     compared is the look of those controls in the two themes, not a dialog. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <TextBlock Text="Dialogs" FontSize="28" FontWeight="SemiBold" />

  <TextBlock Text="ManagedFileChooser" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="640" Height="420" HorizontalAlignment="Left"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListView Grid.Column="0" Grid.RowSpan="4" />

    <Grid Grid.Column="1" Grid.Row="0" Margin="12,5,12,5" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0">
        <FontIcon Glyph="&#xE74A;" FontSize="16" />
      </Button>
      <TextBox Grid.Column="1" />
      <Button Grid.Column="2">
        <FontIcon Glyph="&#xE72C;" FontSize="16" />
      </Button>
    </Grid>

    <Grid Grid.Column="1" Grid.Row="1" Margin="16,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="275" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="16" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="Name" />
      <Rectangle Grid.Column="2" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <TextBlock Grid.Column="3" Text="Date Modified" />
      <Rectangle Grid.Column="4" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <TextBlock Grid.Column="5" Text="Type" />
      <Rectangle Grid.Column="6" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <TextBlock Grid.Column="7" Text="Size" />
      <Rectangle Grid.Column="8" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Grid>

    <ListView Grid.Column="1" Grid.Row="2" />

    <Grid Grid.Column="1" Grid.Row="3" Margin="12,0,12,5" RowSpacing="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" PlaceholderText="File name" />
        <ComboBox Grid.Column="1" Margin="8,0,0,0" />
      </Grid>
      <CheckBox Grid.Row="1" Content="Show hidden files" HorizontalAlignment="Left" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
        <Button Content="OK" MinWidth="80" IsEnabled="False" />
        <Button Content="Cancel" MinWidth="80" IsEnabled="False" />
      </StackPanel>
    </Grid>
  </Grid>
</StackPanel>
