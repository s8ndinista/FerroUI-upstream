<!-- The native WinUI 3 counterpart of TablePage.xaml. TableView of WinUI is not in the Windows App
     SDK release the comparison runs with (1.6), so the table is a row of column headers over a
     ListView whose items are the rows, with the same columns (2*, *, *) and the same rows as
     the framework's table (table_page.rs). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <TextBlock Text="Table view" FontSize="28" FontWeight="SemiBold" />

  <TextBlock Text="TableView" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="560" Height="260" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>
    <ListView Grid.Row="1" SelectionMode="Single">
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Report.docx" />
          <TextBlock Grid.Column="1" Text="Document" />
          <TextBlock Grid.Column="2" Text="24 KB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" IsSelected="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Budget.xlsx" />
          <TextBlock Grid.Column="1" Text="Spreadsheet" />
          <TextBlock Grid.Column="2" Text="48 KB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Photo.jpg" />
          <TextBlock Grid.Column="1" Text="Picture" />
          <TextBlock Grid.Column="2" Text="2.1 MB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Notes.txt" />
          <TextBlock Grid.Column="1" Text="Text" />
          <TextBlock Grid.Column="2" Text="2 KB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Archive.zip" />
          <TextBlock Grid.Column="1" Text="Archive" />
          <TextBlock Grid.Column="2" Text="12 MB" />
        </Grid>
      </ListViewItem>
    </ListView>
  </Grid>

  <TextBlock Text="Disabled TableView" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="560" Height="180" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
      <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
    </Grid>
    <ListView Grid.Row="1" SelectionMode="Single" IsEnabled="False">
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Report.docx" />
          <TextBlock Grid.Column="1" Text="Document" />
          <TextBlock Grid.Column="2" Text="24 KB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Budget.xlsx" />
          <TextBlock Grid.Column="1" Text="Spreadsheet" />
          <TextBlock Grid.Column="2" Text="48 KB" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Photo.jpg" />
          <TextBlock Grid.Column="1" Text="Picture" />
          <TextBlock Grid.Column="2" Text="2.1 MB" />
        </Grid>
      </ListViewItem>
    </ListView>
  </Grid>
</StackPanel>
