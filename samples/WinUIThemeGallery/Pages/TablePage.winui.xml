<!-- The native WinUI 3 counterpart of TablePage.xaml. TableView of WinUI is not in the Windows App
     SDK release the comparison runs with (1.6), so the table is a row of column headers over a
     ListView whose items are the rows, with the same columns (2*, *, *) and the same rows as
     the framework's table (table_page.rs). The stand-in differs from the framework's table by
     design: the framework's theme follows WinUI's TableView (the controls/dev/TableView of
     microsoft-ui-xaml, which the Windows App SDK 1.6 does not ship), whose header band has the
     fill of the tabular surfaces and whose cells have grid lines, while a ListView has neither.
     What can be aligned is aligned: the header row is the 40 of TableViewRowMinHeight with the
     1 px grid line under it and the 1 px border of the table above it (42), a row is 41 (the
     40 and its grid line), and the text of the headers and the cells is 8 px into its column
     (TableViewHeaderCellPadding, TableViewCellPadding) of the 558 px inside the border of the
     table (the ListViewItem keeps its margin of 4 px, which the negative margin of the cell grid
     takes back). -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <TextBlock Text="Table view" FontSize="28" FontWeight="SemiBold" />

  <TextBlock Text="TableView" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="560" Height="260" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="1,1,1,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center" />
    </Grid>
    <ListView Grid.Row="1" SelectionMode="Single">
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Report.docx" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Document" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="24 KB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0" IsSelected="True">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Budget.xlsx" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Spreadsheet" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="48 KB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Photo.jpg" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Picture" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="2.1 MB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Notes.txt" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Text" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="2 KB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Archive.zip" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Archive" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="12 MB" Margin="8,0" />
        </Grid>
      </ListViewItem>
    </ListView>
  </Grid>

  <TextBlock Text="Disabled TableView" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
  <Grid Width="560" Height="180" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="1,1,1,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
      <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorDisabledBrush}" />
    </Grid>
    <ListView Grid.Row="1" SelectionMode="Single" IsEnabled="False">
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Report.docx" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Document" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="24 KB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Budget.xlsx" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Spreadsheet" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="48 KB" Margin="8,0" />
        </Grid>
      </ListViewItem>
      <ListViewItem HorizontalContentAlignment="Stretch" MinHeight="41" Padding="0">
        <Grid Margin="-3,0,-3,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Photo.jpg" Margin="8,0" />
          <TextBlock Grid.Column="1" Text="Picture" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="2.1 MB" Margin="8,0" />
        </Grid>
      </ListViewItem>
    </ListView>
  </Grid>
</StackPanel>
