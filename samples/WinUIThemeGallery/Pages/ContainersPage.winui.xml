<!-- The native WinUI 3 counterpart of ContainersPage.xaml. Expander, SplitView and PathIcon have
     the same names. The pointer-over expander is in the normal state (its header is a part of
     its template, whose states cannot be set from markup). WinUI has no counterparts of the
     others, which are composed of what WinUI has, as the WinUI theme of the framework builds
     them (docs/porting/winui-theme/DEVIATIONS.md): GroupBox is the header bar of an Expander
     over its content (an expanded Expander without its chevron), HeaderedContentControl the
     header of a TextBox (TextControlHeaderForeground, TextBoxTopHeaderMargin) over its content,
     Separator the rectangle of MenuFlyoutSeparator (its padding -4,1,-4,1 reaches past both
     sides), GridSplitter a bar of the strong control brush between two panes,
     TransitioningContentControl a ContentControl that stretches its content, and a theme
     variant scope an element with a requested theme. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="24" Spacing="12">
  <TextBlock Text="Containers" FontSize="28" FontWeight="SemiBold" />

  <Grid ColumnSpacing="24" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="12">
      <TextBlock Text="Expander" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Expander Width="320" Header="Collapsed">
        <TextBlock Text="The content of the expander." />
      </Expander>
      <Expander Width="320" Header="Expanded" IsExpanded="True">
        <TextBlock Text="The content of the expander." />
      </Expander>
      <Expander Width="320" Header="Pointer over">
        <TextBlock Text="The content of the expander." />
      </Expander>
      <Expander Width="320" Header="Disabled" IsEnabled="False">
        <TextBlock Text="The content of the expander." />
      </Expander>

      <TextBlock Text="GroupBox" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid Width="320">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" MinHeight="{StaticResource ExpanderMinHeight}"
                Padding="{StaticResource ExpanderHeaderPadding}" CornerRadius="4,4,0,0"
                Background="{ThemeResource ExpanderHeaderBackground}"
                BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}">
          <TextBlock Text="A group" VerticalAlignment="Center"
                     Foreground="{ThemeResource ExpanderHeaderForeground}" />
        </Border>
        <Border Grid.Row="1" MinHeight="{StaticResource ExpanderMinHeight}"
                Padding="{StaticResource ExpanderContentPadding}" CornerRadius="0,0,4,4"
                Background="{ThemeResource ExpanderContentBackground}"
                BorderBrush="{ThemeResource ExpanderContentBorderBrush}"
                BorderThickness="{ThemeResource ExpanderContentDownBorderThickness}">
          <TextBlock Text="The content of the group." />
        </Border>
      </Grid>

      <TextBlock Text="HeaderedContentControl" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Width="320" HorizontalAlignment="Left">
        <TextBlock Text="A header" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextControlHeaderForeground}"
                   Margin="{ThemeResource TextBoxTopHeaderMargin}" />
        <TextBlock Text="The content under the header." />
      </StackPanel>

      <TextBlock Text="Separator" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid Width="320" HorizontalAlignment="Left">
        <Rectangle Height="{StaticResource MenuFlyoutSeparatorHeight}"
                   Margin="{StaticResource MenuFlyoutSeparatorThemePadding}"
                   Fill="{ThemeResource MenuFlyoutSeparatorBackground}" />
      </Grid>

      <TextBlock Text="TransitioningContentControl" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ContentControl Content="The content of a transitioning content control."
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </StackPanel>

    <StackPanel Grid.Column="1" Spacing="12">
      <TextBlock Text="SplitView" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <SplitView Width="320" Height="120"
                 IsPaneOpen="True"
                 DisplayMode="Inline"
                 OpenPaneLength="120">
        <SplitView.Pane>
          <TextBlock Text="The pane" Margin="12" />
        </SplitView.Pane>
        <TextBlock Text="The content" Margin="12" />
      </SplitView>

      <TextBlock Text="GridSplitter" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid Width="320" Height="80">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Left" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Rectangle Grid.Column="1" Width="4" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        <TextBlock Grid.Column="2" Text="Right" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Grid>

      <TextBlock Text="PathIcon" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <PathIcon Width="20" Height="20" Data="M11,5H13V11H19V13H13V19H11V13H5V11H11Z" />
        <PathIcon Width="20" Height="20" Data="M4,12.5L5.5,11L9.5,15L18.5,6L20,7.5L9.5,18Z" />
        <PathIcon Width="20" Height="20" Data="M5,5H19V19H5Z M7,7V17H17V7Z" />
        <PathIcon Width="20" Height="20" Data="M5,11H19V13H5Z" />
      </StackPanel>

      <TextBlock Text="ThemeVariantScope" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Grid RequestedTheme="Light">
          <Border Width="156" Padding="12" CornerRadius="4"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="Light scope" />
              <Button Content="Button" />
              <CheckBox Content="Checked" IsChecked="True" />
            </StackPanel>
          </Border>
        </Grid>
        <Grid RequestedTheme="Dark">
          <Border Width="156" Padding="12" CornerRadius="4"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="Dark scope" />
              <Button Content="Button" />
              <CheckBox Content="Checked" IsChecked="True" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</StackPanel>
